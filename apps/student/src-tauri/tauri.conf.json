{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncClassroom Student",
  "identifier": "com.syncclassroom.student",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../../../public"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": {
      "frontend/admin.html":   "frontend/admin.html",
      "frontend/offline.html": "frontend/offline.html"
    },
    "windows": {
      "nsis": {
        "languages":   ["SimpChinese"],
        "installMode": "perMachine"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}

