{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncClassroom Teacher",
  "identifier": "com.syncclassroom.teacher",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../../../public"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": {
      "../../../public":             "public",
      "../../../assets":             "assets",
      "../../../create-course.md":   "create-course.md",
      "../../../course-template.md": "course-template.md"
    },
    "windows": {
      "nsis": {
        "languages":   ["SimpChinese"],
        "installMode": "perMachine"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}
